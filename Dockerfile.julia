# Optional CPU classifier image. The default Dockerfile remains Go-only.
FROM --platform=$BUILDPLATFORM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY pkg/ pkg/
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /security-graph ./cmd/security-graph

FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS julia
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY scripts/julia/requirements.txt /opt/julia-runtime/requirements.txt
RUN python -m venv /opt/julia-venv && /opt/julia-venv/bin/pip install -r /opt/julia-runtime/requirements.txt
COPY scripts/julia/bundle.py scripts/julia/install.py scripts/julia/manifest.json /opt/julia-runtime/
RUN /opt/julia-venv/bin/python /opt/julia-runtime/install.py --model-dir /opt/julia-model
COPY scripts/julia/classify.py /opt/julia-runtime/classify.py
RUN chmod -R a-w /opt/julia-model /opt/julia-runtime /opt/julia-venv

LABEL org.opencontainers.image.source="https://github.com/superagent-ai/security-graph"
COPY --from=build /security-graph /security-graph
COPY deploy/gcp/supabase-ca.crt /etc/security-graph/supabase-ca.crt
USER 65532:65532
ENV LISTEN_ADDR=:8080 \
    CLASSIFIER_COMMAND=/opt/julia-venv/bin/python \
    CLASSIFIER_MODE=worker \
    CLASSIFIER_TIMEOUT=120s \
    CLASSIFIER_ARGS='["/opt/julia-runtime/classify.py","--worker","--model-dir","/opt/julia-model"]' \
    CLASSIFICATION_THRESHOLD=0.95
EXPOSE 8080
ENTRYPOINT ["/security-graph"]
CMD ["serve"]
