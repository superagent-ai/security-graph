  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Persist the calling agent's selected vulnerability types and compliance entries, with rationale. Both lists are required; empty is valid when no option applies. No inference runs. Requires read and graph:write and current finding/classification versions.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "compliance_ids": {
          "description": "Select zero or more compliance/framework entry IDs from get_classification_options. Empty means no applicable mapping; mappings are not proof of compliance.",
          "items": {
            "enum": [
              "cwe:CWE-89",
              "owasp-web:A05",
              "cwe:CWE-78",
              "cwe:CWE-79",
              "cwe:CWE-918",
              "owasp-web:A01",
              "cwe:CWE-22",
              "cwe:CWE-862",
              "cwe:CWE-639",
              "cwe:CWE-287",
              "cwe:CWE-502",
              "cwe:CWE-200",
              "aiuc-1:B002",
              "aiuc-1:B006",
              "owasp-llm:LLM01",
              "owasp-llm:LLM06",
              "mitre-atlas:AML.T0051",
              "mitre-atlas:AML.T0051.001"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "expected_classification_version": {
          "description": "0 for first classification; otherwise the current classification record version.",
          "type": "integer"
        },
        "expected_version": {
          "description": "Current finding version; classification does not change it.",
          "type": "integer"
        },
        "finding_id": {
          "type": "string"
        },
        "idempotency_key": {
          "description": "Stable key for retrying exactly this mutation.",
          "type": "string"
        },
        "intent": {
          "description": "Required purpose of this action; 1 to 500 nonblank characters. Never include secrets.",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "rationale": {
          "description": "Explain how the evidence supports these selections, or why no catalog choice applies.",
          "type": "string"
        },
        "type_ids": {
          "description": "Select zero or more vulnerability type IDs from get_classification_options. Never invent IDs.",
          "items": {
            "enum": [
              "sql_injection",
              "blind_sql_injection",
              "command_injection",
              "cross_site_scripting",
              "stored_xss",
              "ssrf",
              "path_traversal",
              "missing_authorization",
              "idor",
              "authentication_bypass",
              "insecure_deserialization",
              "sensitive_data_exposure",
              "prompt_injection",
              "indirect_prompt_injection",
              "excessive_agency",
              "unsafe_tool_use"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "intent",
        "idempotency_key",
        "finding_id",
        "expected_version",
        "expected_classification_version",
        "type_ids",
        "compliance_ids",
        "rationale"
      ],
      "type": "object"
    },
    "name": "set_finding_classification"
  },
  {
