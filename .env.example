# Replace this password and percent-encode it in DATABASE_URL if needed.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://security_graph:replace-with-a-long-random-password@postgres:5432/security_graph?sslmode=disable
# sslmode=disable is only for the local Compose network; use verify-full for a remote DB.

# Default standalone storage; use superagent only with the existing app database
# after applying its native integration migration. No organization setting.
# Local stdio supports standalone storage only; native mode requires HTTP auth.
# STORAGE_BACKEND=superagent
# LISTEN_ADDR=127.0.0.1:8080

# Optional local classifier for host-run serve/stdio. Install the pinned Julia
# runtime separately; see docs/vulnerability-catalog.md. The default Go container
# does not include Python or model weights.
# CLASSIFIER_COMMAND=/absolute/path/julia-venv/bin/python
# CLASSIFIER_ARGS=["/absolute/path/security-graph/scripts/julia/classify.py","--model-dir","/absolute/path/julia-model"]
# CLASSIFICATION_THRESHOLD=0.95
